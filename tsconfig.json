{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/crawler/**/*",
    "src/db/check-data.ts",
    "src/db/fill-pinyin.ts",
    "src/db/fix-*.ts",
    "src/db/import-*.ts",
    "src/db/init.ts",
    "src/db/merge-*.ts",
    "src/db/migrate-search-vector.ts",
    "src/db/run-*.ts",
    "src/db/seed.ts",
    "src/db/update-*.ts"
  ]
}
